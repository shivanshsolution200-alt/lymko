<section class="feature-icons-pro" style="--bg-color: {{ section.settings.bg }};">
  <div class="page-width">
    <div class="feature-icons-wrapper">

      {% for block in section.blocks %}
        <div class="feature-box" {{ block.shopify_attributes }}>

          <div class="feature-icon">
            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | image_url: width: 100 }}"
                alt="{{ block.settings.title | escape }}"
                width="40"
                height="40"
                loading="lazy">
            {% endif %}
          </div>

          <div class="feature-text">
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
          </div>

        </div>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Icons Pro",
  "tag": "section",
  "class": "section-feature-icons",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "POWERED BY NATURE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Natural ingredients that nourish, protect and bring out the best in your skin."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Feature Icons Pro",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "POWERED BY NATURE",
            "description": "Natural ingredients that nourish, protect and bring out the best in your skin."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "BACKED BY SCIENCE",
            "description": "Advanced nano bio quantum technology for visible, real and lasting results."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "CLEAN & SAFE",
            "description": "Toxin-free, cruelty-free and dermatologically tested for your safety."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "SUSTAINABLE BEAUTY",
            "description": "Responsible skincare for you and our planet, today and tomorrow."
          }
        }
      ]
    }
  ]
}
{% endschema %}
<style>
    .feature-icons-pro{
    background: var(--bg-color);
    padding:55px 0;
    border-top:1px solid #ece8e3;
    border-bottom:1px solid #ece8e3;
}

.feature-icons-pro .page-width{
    max-width:1400px;
    margin:0 auto;
    padding:0 20px;
}

.feature-icons-wrapper{
    display:grid;
    grid-template-columns:repeat(4,1fr);
}

.feature-box{
    display:flex;
    align-items:flex-start;
    gap:22px;
    padding:0 35px;
    position:relative;
    min-height:140px;
}

.feature-box:not(:last-child)::after{
    content:"";
    position:absolute;
    right:0;
    top:5px;
    width:1px;
    height:130px;
    background:#e8e3dc;
}

.feature-icon{
    width:74px;
    height:74px;
    min-width:74px;
    border-radius:50%;
    background:#f8f6ef;
    display:flex;
    align-items:center;
    justify-content:center;
}

.feature-icon img{
    width:36px;
    height:36px;
    object-fit:contain;
    display:block;
}

.feature-text{
    flex:1;
}

.feature-text h3{
    margin:0 0 12px;
    font-size:18px;
    line-height:1.2;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#233626;
}

.feature-text p{
    margin:0;
    font-size:16px;
    line-height:1.8;
    color:#666;
}

@media screen and (max-width:990px){

.feature-icons-wrapper{
    grid-template-columns:repeat(2,1fr);
    gap:35px;
}

.feature-box{
    padding:0;
}

.feature-box::after{
    display:none;
}

}

@media screen and (max-width:749px){

.feature-icons-pro{
    padding:40px 0;
}

.feature-icons-wrapper{
    grid-template-columns:1fr;
    gap:25px;
}

.feature-box{
    border-bottom:1px solid #ece8e3;
    padding-bottom:25px;
}

.feature-box:last-child{
    border-bottom:none;
    padding-bottom:0;
}

.feature-icon{
    width:66px;
    height:66px;
    min-width:66px;
}

.feature-icon img{
    width:32px;
    height:32px;
}

.feature-text h3{
    font-size:17px;
}

.feature-text p{
    font-size:15px;
    line-height:1.7;
}

}
/* Better alignment */
.feature-box{
    align-items:center;
}

/* Smooth hover */
.feature-box{
    transition:.35s ease;
}

.feature-box:hover{
    transform:translateY(-4px);
}

.feature-box:hover .feature-icon{
    background:#eef2e5;
}

/* Icon */
.feature-icon img{
    width:38px;
    height:38px;
    object-fit:contain;
    display:block;
}

/* Better text rendering */
.feature-text h3,
.feature-text p{
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
}
</style>